filters:
  and:
    - file.inFolder("Log/Weeks")
    - kind == "training-week"
    - week_start != null
formulas:
  week_status: if(week_start <= today() && week_end >= today(), "0 Aktuell", if(week_start > today(), "1 Demnaechst", "2 Abgeschlossen"))
properties:
  formula.week_status:
    displayName: Status
  note.week_number:
    displayName: Woche
  note.week_start:
    displayName: Start
  note.phase:
    displayName: Phase
  note.hours_planned:
    displayName: Soll (h)
  note.hours_actual:
    displayName: Ist (h)
  note.long_bike_planned:
    displayName: Long Bike Soll
  note.long_bike_actual:
    displayName: Long Bike Ist
  note.long_run_planned:
    displayName: Long Run Soll
  note.long_run_actual:
    displayName: Long Run Ist
  note.swim_planned:
    displayName: Swim Soll
  note.swim_actual:
    displayName: Swim Ist
  note.quality_planned:
    displayName: Quality Soll
  note.quality_actual:
    displayName: Quality Ist
  note.strength_planned:
    displayName: Kraft Soll (Einheiten)
  note.strength_actual:
    displayName: Kraft Ist (Einheiten)
  note.rpe:
    displayName: RPE
views:
  - type: table
    name: Wochenlog
    groupBy:
      property: formula.week_status
      direction: ASC
    order:
      - file.name
      - week_number
      - week_start
      - phase
      - hours_planned
      - hours_actual
      - long_bike_planned
      - long_bike_actual
      - long_run_planned
      - long_run_actual
      - swim_planned
      - swim_actual
      - quality_planned
      - quality_actual
      - strength_planned
      - strength_actual
      - rpe
