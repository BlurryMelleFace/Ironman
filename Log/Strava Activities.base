filters:
  and:
    - 'file.inFolder("Log/Strava/Activities")'
    - 'kind == "strava-activity"'
    - 'week_start != null'
views:
  - type: table
    name: Aktivitäten nach Woche
    groupBy:
      property: note.week_start
      direction: DESC
    order:
      - note.week_number
      - note.week_start
      - note.activity_date
      - note.sport
      - note.activity_name
      - note.distance_km
      - note.moving_time
      - note.elevation_gain_m
      - note.average_heartrate
      - note.average_watts
      - note.strava_url
properties:
  note.week_number:
    displayName: Woche
  note.week_start:
    displayName: Wochenstart
  note.activity_date:
    displayName: Datum
  note.sport:
    displayName: Sport
  note.activity_name:
    displayName: Aktivität
  note.distance_km:
    displayName: Distanz (km)
  note.moving_time:
    displayName: Bewegungszeit
  note.elevation_gain_m:
    displayName: Höhenmeter
  note.average_heartrate:
    displayName: Ø HF
  note.average_watts:
    displayName: Ø Watt
  note.strava_url:
    displayName: Strava
