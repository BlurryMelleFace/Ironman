filters:
  and:
    - file.inFolder("Log/Days")
    - kind == "training-day"
    - date == today()
properties:
  note.weekday:
    displayName: Day
  note.planned:
    displayName: To do today
  note.done:
    displayName: Done
  note.skipped:
    displayName: Skipped
  note.actual:
    displayName: Actual (what you did)
  note.rpe:
    displayName: RPE (1-10)
  note.hours:
    displayName: Hours (e.g. 1.5)
  note.metrics:
    displayName: Metrics (HR, pace, power, distance, weight...)
  note.notes:
    displayName: How did it go?
views:
  - type: table
    name: Today
    order:
      - planned
      - done
      - skipped
    rowHeight: tall
    columnSize:
      note.planned: 200
      note.done: 70
      note.skipped: 80
  - type: table
    name: Today stats
    order:
      - rpe
      - hours
      - metrics
    rowHeight: tall
    columnSize:
      note.rpe: 90
      note.hours: 90
      note.metrics: 240
  - type: table
    name: Today notes
    order:
      - actual
      - notes
    rowHeight: tall
    columnSize:
      note.actual: 240
      note.notes: 240
  - type: cards
    name: Today (cards)
    order:
      - weekday
      - planned
      - done
      - skipped
      - actual
      - rpe
      - hours
      - metrics
      - notes
    cardSize: 600
  - type: table
    name: Sicht
  - type: table
    name: Yesterday
