filters:
  and:
    - file.inFolder("Log/Days")
    - kind == "training-day"
    - date == today()
properties:
  note.weekday:
    displayName: Day
  note.planned:
    displayName: To do today
  note.done:
    displayName: Done
  note.skipped:
    displayName: Skip
  note.actual:
    displayName: Actual (what you did)
  note.rpe:
    displayName: RPE (1-10)
  note.hours:
    displayName: Hours
  note.notes:
    displayName: How did it go?
  note.swim_m:
    displayName: Swim (m)
  note.bike_km:
    displayName: Bike (km)
  note.run_km:
    displayName: Run (km)
  note.strength_min:
    displayName: Strength (min)
  note.avg_hr:
    displayName: Avg HR
  note.sleep_h:
    displayName: Sleep (h)
  note.energy:
    displayName: Energy (1-5)
  note.weight_kg:
    displayName: Weight (kg)
views:
  - type: table
    name: Today
    order:
      - planned
      - done
      - skipped
    rowHeight: medium
    columnSize:
      note.planned: 300
      note.done: 70
      note.skipped: 70
  - type: table
    name: Today stats
    order:
      - rpe
      - hours
    rowHeight: short
    columnSize:
      note.rpe: 267
      note.hours: 110
  - type: table
    name: Today volume
    order:
      - swim_m
      - bike_km
      - run_km
      - strength_min
    rowHeight: short
    columnSize:
      note.swim_m: 110
      note.bike_km: 110
      note.run_km: 110
      note.strength_min: 130
  - type: table
    name: Today body
    order:
      - avg_hr
      - sleep_h
      - energy
      - weight_kg
    rowHeight: short
    columnSize:
      note.avg_hr: 110
      note.sleep_h: 110
      note.energy: 120
      note.weight_kg: 120
  - type: table
    name: Today notes
    order:
      - actual
      - notes
    rowHeight: medium
    columnSize:
      note.actual: 240
      note.notes: 240
  - type: cards
    name: Today (cards)
    order:
      - weekday
      - planned
      - done
      - skipped
      - actual
      - rpe
      - hours
      - notes
    cardSize: 600
  - type: table
    name: Sicht
  - type: table
    name: Yesterday
