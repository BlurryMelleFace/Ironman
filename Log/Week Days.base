filters:
  and:
    - file.inFolder("Log/Days")
    - kind == "training-day"
    - week_number == this.week_number
properties:
  note.weekday:
    displayName: Day
  note.date:
    displayName: Date
  note.planned:
    displayName: Planned
  note.done:
    displayName: Done
  note.skipped:
    displayName: Skipped
  note.actual:
    displayName: Actual
  note.rpe:
    displayName: RPE
  note.hours:
    displayName: Hours
  note.notes:
    displayName: Notes
  note.swim_m:
    displayName: Swim (m)
  note.bike_km:
    displayName: Bike (km)
  note.run_km:
    displayName: Run (km)
  note.strength_min:
    displayName: Strength (min)
  note.avg_hr:
    displayName: Avg HR
  note.sleep_h:
    displayName: Sleep (h)
  note.energy:
    displayName: Energy
  note.weight_kg:
    displayName: Weight (kg)
views:
  - type: table
    name: Days
    order:
      - weekday
      - date
      - planned
      - done
      - skipped
      - actual
      - rpe
      - hours
      - swim_m
      - bike_km
      - run_km
      - strength_min
      - avg_hr
      - sleep_h
      - energy
      - weight_kg
      - notes
    sort:
      - property: date
        direction: ASC
    summaries:
      done: Checked
      skipped: Checked
      rpe: Average
      hours: Sum
      swim_m: Sum
      bike_km: Sum
      run_km: Sum
      strength_min: Sum
      avg_hr: Average
      sleep_h: Average
      energy: Average
