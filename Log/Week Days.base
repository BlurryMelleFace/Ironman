filters:
  and:
    - file.inFolder("Log/Days")
    - kind == "training-day"
    - week_number == this.week_number
formulas:
  title: file.asLink(note.weekday + " · " + note.date.format("D MMM"))
  status: if(note.done == true, "✅ Done", if(note.skipped == true, "❌ Skipped", "⬜ Not logged"))
  effort: if(note.hours, "" + note.hours + " h     ", "") + if(note.rpe, "RPE " + note.rpe, "")
  volume: if(note.swim_m, "🏊 " + note.swim_m + " m     ", "") + if(note.bike_km, "🚴 " + note.bike_km + " km     ", "") + if(note.run_km, "🏃 " + note.run_km + " km     ", "") + if(note.strength_min, "💪 " + note.strength_min + " min", "")
properties:
  formula.title:
    displayName: Day
  formula.status:
    displayName: Status
  formula.effort:
    displayName: Time and effort
  formula.volume:
    displayName: Volume
  note.weekday:
    displayName: Day
  note.date:
    displayName: Date
  note.planned:
    displayName: Planned
  note.done:
    displayName: Done
  note.skipped:
    displayName: Skipped
  note.actual:
    displayName: Actual
  note.rpe:
    displayName: RPE
  note.hours:
    displayName: Hours
  note.notes:
    displayName: Notes
  note.swim_m:
    displayName: Swim (m)
  note.bike_km:
    displayName: Bike (km)
  note.run_km:
    displayName: Run (km)
  note.strength_min:
    displayName: Strength (min)
views:
  - type: cards
    name: Day cards
    order:
      - formula.title
      - formula.status
      - planned
      - actual
      - formula.effort
      - formula.volume
      - notes
    sort:
      - property: date
        direction: ASC
    cardSize: 300
  - type: table
    name: Days
    order:
      - weekday
      - date
      - planned
      - done
      - skipped
      - actual
      - rpe
      - hours
      - swim_m
      - bike_km
      - run_km
      - strength_min
      - notes
    sort:
      - property: date
        direction: ASC
    summaries:
      done: Checked
      skipped: Checked
      rpe: Average
      hours: Sum
      swim_m: Sum
      bike_km: Sum
      run_km: Sum
      strength_min: Sum
